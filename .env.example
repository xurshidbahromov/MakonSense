# MakonSense Environment Variables

# PostgreSQL + PostGIS Database
POSTGRES_USER=makon_admin
POSTGRES_PASSWORD=makon_secure_password
POSTGRES_DB=makonsense_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Connection Strings
DATABASE_URL=postgresql+asyncpg://makon_admin:makon_secure_password@localhost:5432/makonsense_db
SYNC_DATABASE_URL=postgresql://makon_admin:makon_secure_password@localhost:5432/makonsense_db

# Martin Tile Server
MARTIN_PORT=3000

# Backend API Configuration
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="MakonSense Spatial Intelligence"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_TILE_SERVER_URL=http://localhost:3000
